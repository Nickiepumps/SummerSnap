  m_Name: Dialog_InTemple
  m_EditorClassIdentifier: 
  lines:
  - speaker: 0
    emotion: 0
    text: "\u0E2D\u0E31\u0E48\u0E07\u0E40\u0E1B\u0E32\n\u201C\u0E40\u0E02\u0E49\u0E32\u0E44\u0E1B\u0E44\u0E2B\u0E27\u0E49\u0E1E\u0E23\u0E30\u0E01\u0E31\u0E19\u0E40\u0E16\u0E2D\u0E30!\u201D"
    changeBackground: 0
    newBackground: {fileID: 0}
    hasChoices: 0
    choices: []
    nextLineIndex: 1
  - speaker: 1
    emotion: 0
    text: "\u0E23\u0E34\u0E27\n\"\u0E2D\u0E37\u0E49\u0E2D\""
    changeBackground: 0
    newBackground: {fileID: 0}
    hasChoices: 0
    choices: []
    nextLineIndex: 2
  - speaker: 1
    emotion: 0
    text: ......
    changeBackground: 1
    newBackground: {fileID: 21300000, guid: 5fdf72630375d9643a26f6438e98a79a, type: 3}
    hasChoices: 1
    choices: []
    nextLineIndex: 3
  - speaker: 1
    emotion: 0
    text: "\u0E23\u0E34\u0E27 \n\u201C\u0E1E\u0E35\u0E48\u0E02\u0E2D\u0E2D\u0E30\u0E44\u0E23\u0E44\u0E1B\u0E2B\u0E23\u0E2D\u0E04\u0E23\u0E31\u0E1A\u201D\r\n"
    changeBackground: 1
    newBackground: {fileID: 21300000, guid: 5fdf72630375d9643a26f6438e98a79a, type: 3}
    hasChoices: 1
    choices:
    - choiceText: "\u0E2A\u0E38\u0E02\u0E20\u0E32\u0E1E"
      nextLineIndex: 5
      effectType: 0
      choiceResultText: "\u0E2D\u0E31\u0E48\u0E07\u0E40\u0E1B\u0E32\n\u201C\u0E02\u0E2D\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E2A\u0E38\u0E02\u0E20\u0E32\u0E1E\u0E19\u0E48\u0E30
        \u0E0A\u0E48\u0E27\u0E07\u0E19\u0E35\u0E49\u0E1B\u0E27\u0E14\u0E2B\u0E25\u0E31\u0E07\u201D"
      speaker: 0
      emotion: 0
    - choiceText: " \u0E04\u0E27\u0E32\u0E21\u0E23\u0E31\u0E01 "
      nextLineIndex: 6
      effectType: 1
      choiceResultText: "\u0E2D\u0E31\u0E48\u0E07\u0E40\u0E1B\u0E32\n\u201C\u0E04\u2026\u0E04\u0E27\u0E32\u0E21\u0E23\u0E31\u0E01
        \u0E2D\u0E22\u0E32\u0E01\u0E40\u0E08\u0E2D\u0E04\u0E19\u0E17\u0E35\u0E48\u0E14\u0E35\u0E46\u0E19\u0E48\u0E30\u201D"
      speaker: 0
      emotion: 6
    - choiceText: "\u0E22\u0E38\u0E48\u0E07"
      nextLineIndex: 4
      effectType: 2
      choiceResultText: "\u0E2D\u0E31\u0E48\u0E07\u0E40\u0E1B\u0E32\n\u201C\u0E22\u0E38\u0E48\u0E07!
        \u0E44\u0E21\u0E48\u0E1A\u0E2D\u0E01\u0E2B\u0E23\u0E2D\u0E01\u201D"
      speaker: 0
      emotion: 0
    nextLineIndex: 0
  - speaker: 1
    emotion: 3
    text: "\u0E23\u0E34\u0E27\n\u201C\u0E02\u0E2D\u0E42\u0E17\u0E29\u0E04\u0E23\u0E31\u0E1A
      \u0E41\u0E15\u0E48\u0E44\u0E21\u0E48\u0E40\u0E2B\u0E47\u0E19\u0E15\u0E49\u0E2D\u0E07\u0E1E\u0E39\u0E14\u0E02\u0E19\u0E32\u0E14\u0E19\u0E35\u0E49\u0E40\u0E25\u0E22\u201D\r\n"
    changeBackground: 1
    newBackground: {fileID: 21300000, guid: 5fdf72630375d9643a26f6438e98a79a, type: 3}
    hasChoices: 0
    choices: []
    nextLineIndex: 7
  - speaker: 1
    emotion: 4
    text: "\u0E23\u0E34\u0E27 \n\u201C\u0E02\u0E2D\u0E43\u0E2B\u0E49\u0E2B\u0E32\u0E22\u0E44\u0E27\u0E46\u0E19\u0E30\u0E04\u0E23\u0E31\u0E1A
      \u0E41\u0E2E\u0E30\u0E46\u201D\r\n\r\n"
    changeBackground: 1
    newBackground: {fileID: 21300000, guid: 5fdf72630375d9643a26f6438e98a79a, type: 3}
    hasChoices: 0
    choices: []
    nextLineIndex: 7
  - speaker: 1
    emotion: 5
    text: "\u0E23\u0E34\u0E27 \n\u201C\u0E1E\u0E35\u0E48\u0E2D\u0E31\u0E48\u0E07\u0E40\u0E1B\u0E32\u0E15\u0E49\u0E2D\u0E07\u0E40\u0E08\u0E2D\u0E04\u0E19\u0E17\u0E35\u0E48\u0E14\u0E35\u0E46\u0E41\u0E19\u0E48\u201D"
    changeBackground: 1
    newBackground: {fileID: 21300000, guid: 5fdf72630375d9643a26f6438e98a79a, type: 3}
    hasChoices: 0
    choices: []
    nextLineIndex: 7
  - speaker: 0
    emotion: 0
    text: "\u0E2D\u0E31\u0E48\u0E07\u0E40\u0E1B\u0E32 \n\"\u0E44\u0E1B\u0E01\u0E31\u0E19\u0E15\u0E48\u0E2D\u0E40\u0E16\u0E2D\u0E30!\u201D\r\n"
    changeBackground: 0
    newBackground: {fileID: 21300000, guid: 5fdf72630375d9643a26f6438e98a79a, type: 3}
    hasChoices: 0
    choices: []
    nextLineIndex: 8
  - speaker: 1
    emotion: 4
    text: "\u0E23\u0E34\u0E27\n\"\u0E04\u0E49\u0E32\u0E1A\""
    changeBackground: 0
    newBackground: {fileID: 21300000, guid: 5fdf72630375d9643a26f6438e98a79a, type: 3}
