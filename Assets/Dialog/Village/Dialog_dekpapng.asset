  lines:
  - speaker: 0
    emotion: 0
    text: "\u0E40\u0E14\u0E47\u0E01\u0E1C\u0E39\u0E49\u0E0A\u0E32\u0E22\n\"\u0E1E\u0E35\u0E48\u0E04\u0E31\u0E1A\u0E46
      \u0E02\u0E2D\u0E1B\u0E23\u0E30\u0E41\u0E1B\u0E49\u0E07\u0E44\u0E14\u0E49\u0E21\u0E31\u0E49\u0E22\u0E04\u0E31\u0E1A\""
    changeBackground: 0
    newBackground: {fileID: 0}
    hasChoices: 1
    choices:
    - choiceText: "\u0E44\u0E14\u0E49\u0E2A\u0E34\u0E46"
      nextLineIndex: 1
      effectType: 1
      choiceResultText: "\u0E23\u0E34\u0E27 \n\u201C\u0E19\u0E48\u0E32\u0E23\u0E31\u0E01\u201D\r\n"
      speaker: 1
      emotion: 4
    - choiceText: "\u0E40\u0E2D\u0E48\u0E2D..\u0E04\u0E37\u0E2D\u0E27\u0E48\u0E32
        \u0E44\u0E21\u0E48\u0E14\u0E35\u0E01\u0E27\u0E48\u0E32"
      nextLineIndex: 1
      effectType: 0
      choiceResultText: "\u0E23\u0E34\u0E27 \n\u201C\u0E2A\u0E07\u0E01\u0E23\u0E32\u0E19\u0E15\u0E4C\u0E17\u0E31\u0E49\u0E07\u0E17\u0E35\u201D\r\n"
      speaker: 1
      emotion: 0
    - choiceText: "\u0E1E\u0E35\u0E48\u0E44\u0E21\u0E48\u0E40\u0E25\u0E48\u0E19 \u0E44\u0E21\u0E48\u0E40\u0E2B\u0E47\u0E19\u0E2D\u0E48\u0E2D
        \u0E27\u0E48\u0E32\u0E1E\u0E35\u0E48\u0E21\u0E32\u0E17\u0E33\u0E07\u0E32\u0E19"
      nextLineIndex: 1
      effectType: 2
      choiceResultText: "\u0E23\u0E34\u0E27 \n\u201C\u0E40\u0E2D\u0E32\u0E2B\u0E19\u0E48\u0E32\u0E1E\u0E35\u0E48
        \u0E27\u0E31\u0E19\u0E2A\u0E07\u0E01\u0E23\u0E32\u0E19\u0E15\u0E4C\u0E17\u0E31\u0E49\u0E07\u0E17\u0E35\"\r\r\n"
      speaker: 1
      emotion: 0
    nextLineIndex: 0
  - speaker: 1
    emotion: 0
    text: "\u0E23\u0E34\u0E27\u0E44\u0E14\u0E49\u0E40\u0E2D\u0E32\u0E19\u0E34\u0E49\u0E27\u0E41\u0E15\u0E30\u0E41\u0E1B\u0E49\u0E07\u0E43\u0E19\u0E02\u0E31\u0E19
      \u0E41\u0E25\u0E49\u0E27\u0E44\u0E1B\u0E1B\u0E23\u0E30\u0E02\u0E49\u0E32\u0E07\u0E41\u0E01\u0E49\u0E21\u0E02\u0E2D\u0E07\u0E04\u0E19\u0E42\u0E15\u0E01\u0E27\u0E48\u0E32"
    changeBackground: 1
    newBackground: {fileID: 21300000, guid: 41be0a36e704f5f4e9f2d1e173b235d1, type: 3}
    hasChoices: 0
    choices: []
    nextLineIndex: -1
  - speaker: 1
    emotion: 4
    text: "\u0E23\u0E34\u0E27 \n\u201C\u0E19\u0E35\u0E48\u0E44\u0E07\u0E1E\u0E35\u0E48\u0E2D\u0E31\u0E48\u0E07\u0E40\u0E1B\u0E32\u0E21\u0E35\u0E2B\u0E19\u0E27\u0E14\u0E41\u0E21\u0E27\u0E2D\u0E35\u0E01\u0E02\u0E49\u0E32\u0E07\u0E41\u0E25\u0E49\u0E27\u201D "
    changeBackground: 1
    newBackground: {fileID: 21300000, guid: 41be0a36e704f5f4e9f2d1e173b235d1, type: 3}
    hasChoices: 0
    choices: []
    nextLineIndex: -1
  - speaker: 1
    emotion: 4
    text: "\u0E2D\u0E31\u0E48\u0E07\u0E40\u0E1B\u0E32\u0E40\u0E2B\u0E47\u0E19\u0E17\u0E48\u0E32\u0E17\u0E32\u0E07\u0E2B\u0E31\u0E27\u0E40\u0E23\u0E32\u0E30\u0E0A\u0E2D\u0E1A\u0E43\u0E08\u0E02\u0E2D\u0E07\u0E23\u0E34\u0E27
      \u0E08\u0E36\u0E07\u0E40\u0E2D\u0E32\u0E19\u0E34\u0E49\u0E27\u0E41\u0E15\u0E30\u0E41\u0E1B\u0E49\u0E07\u0E43\u0E19\u0E02\u0E31\u0E19
      \u0E41\u0E25\u0E49\u0E27\u0E44\u0E1B\u0E1B\u0E23\u0E30\u0E02\u0E49\u0E32\u0E07\u0E41\u0E01\u0E49\u0E21\u0E04\u0E19\u0E15\u0E23\u0E07\u0E2B\u0E19\u0E49\u0E32\r\n"
    changeBackground: 1
    newBackground: {fileID: 21300000, guid: 41be0a36e704f5f4e9f2d1e173b235d1, type: 3}
    hasChoices: 0
    choices: []
    nextLineIndex: -1
  - speaker: 1
    emotion: 4
    text: "\u0E2D\u0E31\u0E48\u0E07\u0E40\u0E1B\u0E32 \n\u201C\u0E23\u0E34\u0E27\u0E01\u0E47\u0E40\u0E1B\u0E47\u0E19\u0E41\u0E21\u0E27\u0E41\u0E25\u0E49\u0E27\u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E01\u0E31\u0E19^^\u201D"
