    emotion: 0
    text: "\u0E23\u0E34\u0E27 \n\u201C\u0E2E\u0E48\u0E32\u0E46 \u0E02\u0E2D\u0E1A\u0E04\u0E38\u0E13\u0E04\u0E23\u0E31\u0E1A\u0E1E\u0E35\u0E48\u0E48\u201D  "
