  lines:
  - speaker: 0
    emotion: 0
    text: "\u0E2D\u0E31\u0E48\u0E07\u0E40\u0E1B\u0E32 \n\u201C\u0E40\u0E22\u0E47\u0E19\u0E08\u0E31\u0E07
      \u0E27\u0E31\u0E19\u0E19\u0E35\u0E49\u0E2D\u0E32\u0E01\u0E32\u0E28\u0E23\u0E49\u0E2D\u0E19\u0E21\u0E32\u0E01\u0E40\u0E25\u0E22\u201D\r\n"
    changeBackground: 1
    newBackground: {fileID: 21300000, guid: d9cfe7837d49c1a46a1b86c71757981c, type: 3}
    hasChoices: 0
    choices: []
    nextLineIndex: 1
  - speaker: 1
    emotion: 6
    text: "\u0E23\u0E34\u0E27 \n\u201C\u0E08\u0E23\u0E34\u0E07\u0E04\u0E23\u0E31\u0E1A\u201D\r\n"
    changeBackground: 1
    newBackground: {fileID: 21300000, guid: d9cfe7837d49c1a46a1b86c71757981c, type: 3}
    hasChoices: 0
    choices: []
    nextLineIndex: 2
  - speaker: 0
    emotion: 0
    text: "\u0E2D\u0E31\u0E48\u0E07\u0E40\u0E1B\u0E32 \n\u201C\u0E40\u0E2B\u0E19\u0E37\u0E48\u0E2D\u0E22\u0E41\u0E25\u0E49\u0E27\u0E22\u0E31\u0E07\u201D\r"
    changeBackground: 1
    newBackground: {fileID: 21300000, guid: d9cfe7837d49c1a46a1b86c71757981c, type: 3}
    hasChoices: 0
    choices: []
    nextLineIndex: 3
  - speaker: 1
    emotion: 4
    text: "\u0E23\u0E34\u0E27 \n\u201C\u0E44\u0E2B\u0E27\u0E04\u0E23\u0E31\u0E1A\u0E1E\u0E35\u0E48
      \u0E0A\u0E34\u0E25\u0E46\u201D\r\n\r"
    changeBackground: 1
    newBackground: {fileID: 21300000, guid: d9cfe7837d49c1a46a1b86c71757981c, type: 3}
    hasChoices: 0
    choices: []
    nextLineIndex: 4
  - speaker: 0
    emotion: 0
    text: "\u0E2D\u0E31\u0E48\u0E07\u0E40\u0E1B\u0E32 \n\u201C\u0E01\u0E34\u0E19\u0E2D\u0E30\u0E44\u0E23\u0E14\u0E35
      \u0E40\u0E14\u0E35\u0E4B\u0E22\u0E27\u0E1E\u0E35\u0E48\u0E40\u0E25\u0E35\u0E49\u0E22\u0E07\u0E40\u0E2D\u0E07\r                                                   
      \u0E0A\u0E2D\u0E1A\u0E40\u0E04\u0E49\u0E01\u0E2A\u0E15\u0E2D\u0E40\u0E1A\u0E2D\u0E23\u0E35\u0E48\u0E21\u0E31\u0E49\u0E22
      \u0E23\u0E49\u0E32\u0E19\u0E19\u0E35\u0E49\u0E2D\u0E23\u0E48\u0E2D\u0E22\u0E19\u0E30\u201D
      \n(\u0E2D\u0E31\u0E48\u0E07\u0E40\u0E1B\u0E32\u0E22\u0E01\u0E40\u0E21\u0E19\u0E39\u0E02\u0E36\u0E49\u0E19\u0E21\u0E32\u0E41\u0E19\u0E30\u0E19\u0E33\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E04\u0E25\u0E48\u0E2D\u0E07\u0E41\u0E04\u0E25\u0E48\u0E27)\r\n"
    changeBackground: 1
    newBackground: {fileID: 21300000, guid: d9cfe7837d49c1a46a1b86c71757981c, type: 3}
    hasChoices: 0
    choices: []
    nextLineIndex: 5
  - speaker: 1
    emotion: 0
    text: "\u0E23\u0E34\u0E27 \n\u201C\u0E1E\u0E35\u0E48\u0E21\u0E32\u0E17\u0E35\u0E48\u0E19\u0E35\u0E48\u0E1A\u0E48\u0E2D\u0E22\u0E2B\u0E23\u0E2D\u0E04\u0E23\u0E31\u0E1A\u201D\r\n"
    changeBackground: 1
    newBackground: {fileID: 21300000, guid: d9cfe7837d49c1a46a1b86c71757981c, type: 3}
    hasChoices: 0
    choices: []
    nextLineIndex: 6
  - speaker: 0
    emotion: 0
    text: "\u0E2D\u0E31\u0E48\u0E07\u0E40\u0E1B\u0E32 \n\u201C\u0E19\u0E32\u0E19\u0E46\u0E04\u0E23\u0E31\u0E49\u0E07\u0E19\u0E48\u0E30
      \u0E40\u0E1E\u0E23\u0E32\u0E30\u0E2D\u0E22\u0E39\u0E48\u0E43\u0E01\u0E25\u0E49\u0E1A\u0E49\u0E32\u0E19
      \u0E1A\u0E32\u0E07\u0E04\u0E23\u0E31\u0E49\u0E07\u0E40\u0E25\u0E22\u0E21\u0E32\u0E15\u0E32\u0E01\u0E41\u0E2D\u0E23\u0E4C\u0E17\u0E35\u0E48\u0E19\u0E35\u0E48
      \u201D\r"
    changeBackground: 1
    newBackground: {fileID: 21300000, guid: d9cfe7837d49c1a46a1b86c71757981c, type: 3}
    hasChoices: 0
    choices: []
    nextLineIndex: 7
  - speaker: 1
    emotion: 0
    text: "\u0E23\u0E34\u0E27 \n\u201C\u0E21\u0E32\u0E01\u0E31\u0E1A\u0E41\u0E1F\u0E19\u0E2B\u0E23\u0E2D\u0E04\u0E23\u0E31\u0E1A\u201D\r"
    changeBackground: 1
    newBackground: {fileID: 21300000, guid: d9cfe7837d49c1a46a1b86c71757981c, type: 3}
    hasChoices: 0
    choices: []
    nextLineIndex: 8
  - speaker: 0
    emotion: 5
    text: "\u0E2D\u0E31\u0E48\u0E07\u0E40\u0E1B\u0E32 \n\u201C\u0E41\u0E1F\u0E19\u0E40\u0E1F\u0E34\u0E19\u0E2D\u0E30\u0E44\u0E23\u0E44\u0E21\u0E48\u0E21\u0E35\u0E2D\u0E30\u0E44\u0E23\u0E2B\u0E23\u0E2D\u0E01
      \u0E21\u0E32\u0E01\u0E31\u0E1A\u0E2B\u0E21\u0E48\u0E32\u0E21\u0E49\u0E32\u0E19\u0E48\u0E30\u201D\r"
    changeBackground: 1
    newBackground: {fileID: 21300000, guid: d9cfe7837d49c1a46a1b86c71757981c, type: 3}
    hasChoices: 0
    choices: []
    nextLineIndex: 9
  - speaker: 1
    emotion: 4
    text: "\u0E23\u0E34\u0E27 \n\u201C\u0E2B\u0E21\u0E48\u0E32\u0E21\u0E49\u0E32?
      \u0E19\u0E48\u0E32\u0E23\u0E31\u0E01\u0E08\u0E31\u0E07\u0E40\u0E25\u0E22\u0E04\u0E23\u0E31\u0E1A
      \u0E2E\u0E48\u0E32\u0E46\u201D\r\n\r"
    changeBackground: 1
    newBackground: {fileID: 21300000, guid: d9cfe7837d49c1a46a1b86c71757981c, type: 3}
    hasChoices: 0
    choices: []
    nextLineIndex: 10
  - speaker: 0
    emotion: 5
    text: "\u0E2D\u0E31\u0E48\u0E07\u0E40\u0E1B\u0E32 \n\u201C\u0E2E\u0E36\u0E48\u0E21\u201D\r\n"
    changeBackground: 1
    newBackground: {fileID: 21300000, guid: d9cfe7837d49c1a46a1b86c71757981c, type: 3}
    hasChoices: 0
    choices: []
    nextLineIndex: 11
  - speaker: 1
    emotion: 4
    text: "\u0E23\u0E34\u0E27 \n\u201C\u0E41\u0E25\u0E49\u0E27\u0E1E\u0E35\u0E48\u0E0A\u0E2D\u0E1A\u0E04\u0E19\u0E41\u0E1A\u0E1A\u0E44\u0E2B\u0E19\u0E2B\u0E23\u0E2D\u0E04\u0E23\u0E31\u0E1A\u201D\r\n"
    changeBackground: 1
    newBackground: {fileID: 21300000, guid: d9cfe7837d49c1a46a1b86c71757981c, type: 3}
    hasChoices: 0
    choices: []
    nextLineIndex: 12
  - speaker: 0
    emotion: 5
    text: "\u0E2D\u0E31\u0E48\u0E07\u0E40\u0E1B\u0E32 \n(...)"
    changeBackground: 1
    newBackground: {fileID: 21300000, guid: d9cfe7837d49c1a46a1b86c71757981c, type: 3}
    hasChoices: 1
    choices:
    - choiceText: "\u0E0A\u0E2D\u0E1A\u0E04\u0E19\u0E17\u0E35\u0E48\u0E08\u0E23\u0E34\u0E07\u0E43\u0E08
        \u0E14\u0E39\u0E40\u0E1B\u0E47\u0E19\u0E21\u0E34\u0E15\u0E23 \u0E04\u0E38\u0E22\u0E07\u0E48\u0E32\u0E22\u0E46\u0E19\u0E48\u0E30"
      nextLineIndex: 13
      effectType: 1
      choiceResultText: "\u0E23\u0E34\u0E27 \n\u201C\u0E15\u0E23\u0E07\u0E01\u0E31\u0E1A\u0E1C\u0E21\u0E40\u0E25\u0E22\u0E19\u0E35\u0E48\u0E19\u0E32\u201D"
      speaker: 1
      emotion: 4
    - choiceText: "\u0E0A\u0E2D\u0E1A\u0E1C\u0E39\u0E49\u0E2B\u0E0D\u0E34\u0E07 \u0E15\u0E31\u0E27\u0E40\u0E25\u0E47\u0E01\u0E46\u0E19\u0E48\u0E32\u0E23\u0E31\u0E01\u0E46\u0E19\u0E48\u0E30"
      nextLineIndex: 13
      effectType: 2
      choiceResultText: "\u0E23\u0E34\u0E27 \n\u201C\u0E2D\u0E4B\u0E2D\u2026\u0E2D\u0E37\u0E21
        \u0E1E\u0E35\u0E48\u0E2B\u0E25\u0E48\u0E2D\u0E40\u0E14\u0E35\u0E4B\u0E22\u0E27\u0E01\u0E47\u0E21\u0E35\u0E41\u0E1F\u0E19\u201D"
      speaker: 1
      emotion: 3
    - choiceText: "\u0E2D\u0E32\u2026\u0E15\u0E2D\u0E19\u0E19\u0E35\u0E49\u0E1E\u0E36\u0E48\u0E07\u0E40\u0E23\u0E34\u0E48\u0E21\u0E17\u0E33\u0E07\u0E32\u0E19\u0E08\u0E23\u0E34\u0E07\u0E08\u0E31\u0E07
        \u0E40\u0E25\u0E22\u0E2D\u0E22\u0E32\u0E01\u0E42\u0E1F\u0E01\u0E31\u0E2A\u0E01\u0E31\u0E1A\u0E07\u0E32\u0E19\u0E01\u0E48\u0E2D\u0E19\u0E19\u0E48\u0E30"
      nextLineIndex: 13
      effectType: 0
      choiceResultText: "\u0E23\u0E34\u0E27 \n\u201C\u0E19\u0E31\u0E48\u0E19\u0E2A\u0E34\u0E19\u0E30\u0E04\u0E23\u0E31\u0E1A
        \u0E40\u0E28\u0E23\u0E29\u0E10\u0E01\u0E34\u0E08\u0E41\u0E1A\u0E1A\u0E19\u0E35\u0E49
        \u0E01\u0E47\u0E15\u0E49\u0E2D\u0E07\u0E2B\u0E32\u0E40\u0E07\u0E34\u0E19\u0E44\u0E27\u0E49\u0E40\u0E22\u0E2D\u0E30\u0E46\u0E01\u0E48\u0E2D\u0E19\u0E40\u0E19\u0E2D\u0E30\u201D\r\n"
      speaker: 1
      emotion: 0
    nextLineIndex: 0
